# Dependencies and package-manager caches
node_modules/
.npm/
.npmrc

# Next.js outputs, including isolated development, build, and audit runs
.next*/
out/
dist/
build/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Local runtime data: databases, credentials, plans, caches, and logs
/data/*
!/data/.gitignore
!/data/.gitkeep
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.dpapi
*.dpapi.*
ascendry-backup-*.json

# Environment secrets; examples must contain placeholders only
.env
.env.*
!.env.example
!.env.sample

# Generated test, coverage, and audit artifacts (at any depth)
coverage/
playwright-report/
playwright/.cache/
test-results/
blob-report/
*.log

# Operating-system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
